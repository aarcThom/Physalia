<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Doc generation is on so the COMPILER validates the doc comments, not to ship the .xml.
         Without it every <see cref="..."/>, <param>, and <paramref> is unchecked text: a cref to a
         renamed member, a param tag for a parameter that no longer exists, or a paramref on a type
         (which has no parameters at all) all pass silently. A sweep in 2026-08 found 16 such
         defects that had accumulated invisibly. CS1591 stays suppressed because StyleCop's SA1600
         already enforces that members ARE documented — this is here to check that what they SAY
         still resolves. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GhJSON.Core" Version="1.1.1" />
    <PackageReference Include="GhJSON.Grasshopper" Version="1.1.1" />
    <!-- Pinned to the exact version GhJSON.Core 1.1.1 was compiled against: JsonSchema.Net 9.x
         changed the JsonSchema.FromText signature, and since NuGet unifies to the highest version,
         a 9.x reference here makes GhJSON's schema loading throw MissingMethodException at runtime
         ("Method not found: Json.Schema.JsonSchema.FromText"). Keep in lockstep with the GhJSON
         packages' own JsonSchema.Net dependency when bumping either. -->
    <PackageReference Include="JsonSchema.Net" Version="7.2.2" />
    <PackageReference Include="SharpToken" Version="2.0.6" />
  </ItemGroup>

</Project>
