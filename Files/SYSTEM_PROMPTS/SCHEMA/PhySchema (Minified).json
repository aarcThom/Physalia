{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhySchema",
  "type": "object",
  "required": ["schema", "components", "connections"],
  "additionalProperties": false,
  "rules": [
    "One connection entry per wired input (a component with 3 wired inputs needs 3 entries).",
    "paramName is case-sensitive; match componentCatalog exactly, else use the full GH parameter Name.",
    "Wire every required input.",
    "Number Slider value format: 'default<min~max>', e.g. '5<0~10>'.",
    "Give every Number Slider (and other input sources) a nickName naming what it controls (e.g. 'Radius', 'Height'); short and specific. Optional on other components.",
    "id values are unique integers; instanceGuid values are unique UUID v4 strings."
  ],
  "componentCatalog": [
    {"name": "Number Slider", "inputs": [], "outputs": ["Number"]},
    {"name": "Boolean Toggle", "inputs": [], "outputs": ["Boolean"]},
    {"name": "Addition", "inputs": ["A", "B"], "outputs": ["Result"]},
    {"name": "Subtraction", "inputs": ["A", "B"], "outputs": ["Result"]},
    {"name": "Multiplication", "inputs": ["A", "B"], "outputs": ["Result"]},
    {"name": "Division", "inputs": ["A", "B"], "outputs": ["Result"]},
    {"name": "Series", "inputs": ["Start", "Step", "Count"], "outputs": ["Series"]},
    {"name": "Range", "inputs": ["Domain", "Steps"], "outputs": ["Range"]},
    {"name": "Construct Point", "inputs": ["X", "Y", "Z"], "outputs": ["Pt"]},
    {"name": "Vector XYZ", "inputs": ["X", "Y", "Z"], "outputs": ["Vector"]},
    {"name": "Line", "inputs": ["A", "B"], "outputs": ["Line"]},
    {"name": "Circle", "inputs": ["Plane", "Radius"], "outputs": ["Circle"]},
    {"name": "Polyline", "inputs": ["Vertices", "Closed"], "outputs": ["Polyline"]},
    {"name": "Sphere", "inputs": ["Base", "Radius"], "outputs": ["Sphere"]},
    {"name": "Pipe", "inputs": ["Curve", "Radius"], "outputs": ["Brep"]},
    {"name": "Loft", "inputs": ["Curves"], "outputs": ["Loft"]},
    {"name": "Extrude", "inputs": ["Base", "Direction"], "outputs": ["Extrusion"]},
    {"name": "Move", "inputs": ["Geometry", "Motion"], "outputs": ["Geometry"]},
    {"name": "Rotate", "inputs": ["Geometry", "Angle", "Plane"], "outputs": ["Geometry"]},
    {"name": "Scale", "inputs": ["Geometry", "Factor", "Center"], "outputs": ["Geometry"]}
  ],
  "properties": {
    "schema": {"const": "1.0"},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "instanceGuid", "id"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "nickName": {"type": "string"},
          "instanceGuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
          "id": {"type": "integer"},
          "componentState": {"type": "object"}
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "object", "required": ["id", "paramName"], "additionalProperties": false, "properties": {"id": {"type": "integer"}, "paramName": {"type": "string"}}},
          "to": {"type": "object", "required": ["id", "paramName"], "additionalProperties": false, "properties": {"id": {"type": "integer"}, "paramName": {"type": "string"}}}
        }
      }
    }
  },
  "example": {
    "schema": "1.0",
    "components": [
      {"name": "Number Slider", "nickName": "Center X", "instanceGuid": "11111111-1111-1111-1111-111111111111", "id": 1, "componentState": {"extensions": {"gh.numberslider": {"value": "3<0~10>"}}}},
      {"name": "Number Slider", "nickName": "Radius", "instanceGuid": "55555555-5555-5555-5555-555555555555", "id": 5, "componentState": {"extensions": {"gh.numberslider": {"value": "2<0.1~5>"}}}},
      {"name": "Construct Point", "instanceGuid": "44444444-4444-4444-4444-444444444444", "id": 4},
      {"name": "Sphere", "instanceGuid": "66666666-6666-6666-6666-666666666666", "id": 6}
    ],
    "connections": [
      {"from": {"id": 1, "paramName": "Number"}, "to": {"id": 4, "paramName": "X"}},
      {"from": {"id": 4, "paramName": "Pt"}, "to": {"id": 6, "paramName": "Base"}},
      {"from": {"id": 5, "paramName": "Number"}, "to": {"id": 6, "paramName": "Radius"}}
    ]
  }
}
