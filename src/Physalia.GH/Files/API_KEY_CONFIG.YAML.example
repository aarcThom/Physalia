# Physalia API Key Configuration
# Copy this file to API_KEY_CONFIG.YAML and fill in your values.
# API_KEY_CONFIG.YAML is gitignored — never commit your actual keys.
#
# Resolution order per provider:
#   1. Look up the environment variable named in env_vars (if set).
#   2. Fall back to the value in api_keys.
#   3. Fail explicitly if neither is present.

# ── Anthropic ────────────────────────────────────────────────────────────────

anthropic:
  env_vars:
    api_key: ANTHROPIC_API_KEY
  api_keys:
    api_key: ""

# ── Gemini ───────────────────────────────────────────────────────────────────

gemini:
  env_vars:
    api_key: GEMINI_API_KEY
  api_keys:
    api_key: ""

# ── OpenAI-compatible ────────────────────────────────────────────────────────
# Append any additional provider you want to use below using the same format.

openai_compatible:
  env_vars:
    openai: OPENAI_API_KEY
    openrouter: OPENROUTER_API_KEY
    deepseek: DEEPSEEK_API_KEY

  api_keys:
    openai: ""
    openrouter: ""
    deepseek: ""
