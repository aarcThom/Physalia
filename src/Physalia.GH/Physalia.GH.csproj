<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <!-- Select the framework(s) you wish to target.
        Rhino 6: net45
        Rhino 7: net48
        Rhino 8 Windows: net48, net7.0, net7.0-windows, net7.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net7.0, net7.0-macos, net7.0-macos12.0, etc
    -->
    <!-- Build only the relevant TFM per OS — each ships WinForms through different paths -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net7.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net7.0</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.gha</TargetExt>
    <!-- Force VS to invoke MSBuild every build instead of skipping this project via the fast
         up-to-date check. CopyLibraryFiles must run each build so the chat.html that the
         Physalia.UI ProjectReference just regenerated (and any other Files/** edit) is staged
         into bin; when VS skips GH because no .cs changed, bin's UI lags one build behind.
         CoreCompile stays incremental (Csc still skips when no .cs changed), so the only added
         cost is the MSBuild pass. Mirrors the same flag in Physalia.UI.csproj. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <!-- Nullable reference types on, matching Physalia.Core. Per-file '#nullable enable'
         directives were removed once this became project-wide. -->
    <Nullable>enable</Nullable>
    <NoWarn>NU1701</NoWarn>
	<!-- Suppress System.Drawing platform warnings — Rhino ships its own compatibility layer on Mac.
	https://discourse.mcneel.com/t/system-drawing-common-not-compatible-with-macos-anymore/166565
	-->
	<NoWarn>$(NoWarn);CA1416</NoWarn>
	<!-- Doc generation is on so the COMPILER validates the doc comments, not to ship the .xml.
	     Without it every <see cref="..."/>, <param>, and <paramref> is unchecked text: a cref to a
	     renamed member, a param tag for a parameter that no longer exists, or an unqualified cref to
	     a nested type on a generic base all pass silently. A sweep in 2026-08 found 16 such defects
	     that had accumulated invisibly, several pointing at Grasshopper types whose namespace this
	     project never imported. CS1591 stays suppressed because StyleCop's SA1600 already enforces
	     that members ARE documented — this is here to check that what they SAY still resolves. -->
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- WinForms only available on the Windows TFM -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Explicit guard symbol for WinForms-only components (e.g. Serializer). -->
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- Specifies information for Assembly and Yak -->
    <Version>1.0</Version>
    <Title>Physalia.GH</Title>
    <Company>Physalia.GH Authors</Company>
    <Description>Description of Physalia.GH</Description>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.24.25281.15001" ExcludeAssets="runtime" />
    <!-- ExcludeAssets="runtime": Rhino provides System.Drawing on Mac via its own compat layer,
         so this must NOT be shipped (loose) or merged (type-identity clash) — it stays external.
         GeneratePathProperty exposes $(PkgSystem_Drawing_Common) so ILRepack can still resolve
         references to it during the merge even though it never reaches the output dir. -->
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime" GeneratePathProperty="true" />
    <PackageReference Include="GhJSON.Core" Version="1.1.1" />
    <PackageReference Include="GhJSON.Grasshopper" Version="1.1.1" />
    <!-- Build-time only: merges the managed dependency DLLs into the .gha (see RepackGha target). -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.45" PrivateAssets="all" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Physalia.Core\Physalia.Core.csproj" />
    <!-- Build-ordering only (no assembly): forces the chat UI to build first so the fresh
         Files/UI/chat.html exists before CopyLibraryFiles stages Files/** into bin. The UI
         project runs Vite by default (BuildUI=true); pass -p:BuildUI=false to skip it.
         SkipGetTargetFrameworkProperties avoids TFM negotiation with the net7.0 UI wrapper. -->
    <ProjectReference Include="..\Physalia.UI\Physalia.UI.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework"
                      Private="false" />
  </ItemGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
		<!-- Eto UI toolkit (Manage Images panel). Compile against Rhino's exact shipped Eto
		     (2.11) and let the runtime provide it — Private=False, never copied to output. -->
		<Reference Include="Eto">
			<HintPath>C:\Program Files\Rhino 8\System\Eto.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- WebView2 core (ChatWindow's reliable JS->C# postMessage/WebMessageReceived channel).
		     Compile against Rhino's shipped copy; runtime provides it — Private=False. -->
		<Reference Include="Microsoft.Web.WebView2.Core">
			<HintPath>C:\Program Files\Rhino 8\System\Microsoft.Web.WebView2.Core.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- The Python script execution engine -->
		<Reference Include="Rhino.Runtime.Code">
			<HintPath>C:\Program Files\Rhino 8\System\Rhino.Runtime.Code.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- GH Script component public interface (IScriptComponent, ScriptParamSet, etc.) -->
		<Reference Include="RhinoCodePlatform.GH">
			<HintPath>C:\Program Files\Rhino 8\System\RhinoCodePlatform.GH.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- GH Script component concrete types (ScriptTemplate, SetInputsArray, etc.) -->
		<Reference Include="RhinoCodePlatform.GH1">
			<HintPath>C:\Program Files\Rhino 8\System\RhinoCodePlatform.GH1.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
		<!-- Eto UI toolkit (Manage Images panel) — Mac path (best guess, verify against your Rhino 8 install) -->
		<Reference Include="Eto">
			<HintPath>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/Current/Resources/ManagedPlugIns/RhinoCommon.framework/Versions/Current/Eto.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- The Python script execution engine — Mac path (best guess, verify against your Rhino 8 install) -->
		<Reference Include="Rhino.Runtime.Code">
			<HintPath>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/Current/Resources/ManagedPlugIns/RhinoCommon.framework/Versions/Current/Rhino.Runtime.Code.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- TODO (Mac): verify actual paths for RhinoCodePlatform.GH and GH1 on Mac Rhino 8 -->
		<Reference Include="RhinoCodePlatform.GH">
			<HintPath>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/Current/Resources/ManagedPlugIns/RhinoCommon.framework/Versions/Current/RhinoCodePlatform.GH.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="RhinoCodePlatform.GH1">
			<HintPath>/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/Current/Resources/ManagedPlugIns/RhinoCommon.framework/Versions/Current/RhinoCodePlatform.GH1.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<!-- Embed every component icon into the .gha (never copied to the build folder).
	     Resource name = Physalia.GH.Resources.<File>.png; PhyBase resolves it by type name.
	     The leftover sprite-sheet cells (sprite_r*_c*.png) are intentionally excluded. -->
	<ItemGroup>
	  <None Remove="Resources\*.png" />
	  <EmbeddedResource Include="Resources\*.png" Exclude="Resources\sprite_*.png" />
	</ItemGroup>

	<!-- Bundled colour emoji bitmaps (Noto Emoji, Apache-2.0) used as per-instance Chat
	     icons, since GDI cannot colour-render an emoji font. Named emoji_u<codepoint>.png;
	     resource name = Physalia.GH.Resources.emoji.emoji_u<codepoint>.png. See Resources/emoji/NOTICE. -->
	<ItemGroup>
	  <None Remove="Resources\emoji\*.png" />
	  <EmbeddedResource Include="Resources\emoji\*.png" />
	</ItemGroup>

	<!-- Copy the Files folder (system prompts, clusters, presets, memories, API keys) to the output directory.
	     UpToDateCheckBuilt (with Original=) pairs each copied output back to its source so the VS
	     fast up-to-date check rebuilds when a Files entry changes — without this, editing a schema
	     while the C# is unchanged leaves a stale copy in the output.
	     RemoveDir wipes the output Files folder first so deleted/renamed source files do not linger
	     (Copy only adds/overwrites, it never removes).
	     The TargetFramework guard keeps this OUT of the outer multi-targeting dispatch build: with
	     TargetFrameworks (plural) MSBuild runs an outer build where $(TargetFramework)/$(TargetDir)
	     are empty, so the unguarded target's "$(TargetDir)Files" destination resolves to a relative
	     "Files" under the project dir and spawns a stray src/Physalia.GH/Files copy every build. -->
	<Target Name="CopyLibraryFiles" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
		<ItemGroup>
			<LibraryFiles Include="$(MSBuildProjectDirectory)\..\..\Files\**\*" />
		</ItemGroup>
		<RemoveDir Directories="$(TargetDir)Files" />
		<Copy
			SourceFiles="@(LibraryFiles)"
			DestinationFiles="@(LibraryFiles->'$(TargetDir)Files\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="true"
			OverwriteReadOnlyFiles="true" />
		<ItemGroup>
			<UpToDateCheckBuilt
				Include="@(LibraryFiles->'$(TargetDir)Files\%(RecursiveDir)%(Filename)%(Extension)')"
				Original="%(LibraryFiles.Identity)"
				Set="Files" />
		</ItemGroup>
	</Target>

	<!-- Embed the built chat UI bundle (Physalia.UI/dist/index.html) directly into this assembly
	     as Physalia.GH.chat.html. ChatWindow.LoadUi extracts it to a temp file and loads it via
	     file://. The bundle is a compiled plugin component, so it must NOT live in Files/ (that
	     folder is reserved for user-alterable content).
	     This is a TARGET, not a static <EmbeddedResource> item, on purpose: a static item's
	     Condition="Exists(...)" is evaluated at project-evaluation time, which in a solution
	     build runs before Physalia.UI's Vite step — so on a clean build dist/index.html doesn't
	     exist yet and nothing gets embedded. The hook is BeforeTargets="SplitResourcesByCulture"
	     (the target that reads @(EmbeddedResource) and hands it to the compiler): it runs after
	     the referenced UI project has built (so dist/index.html exists) but before the resource
	     list is finalized — hooking CoreCompile instead is too late, since resource prep is a
	     dependency of CoreCompile and has already run by then. When -p:BuildUI=false,
	     dist/index.html is absent, nothing is embedded, and ChatWindow falls back to its
	     "UI not found" page. -->
	<Target Name="EmbedChatHtml" BeforeTargets="SplitResourcesByCulture"
	        Condition="Exists('$(MSBuildProjectDirectory)\..\Physalia.UI\dist\index.html')">
		<Message Importance="high" Text="Physalia.GH: embedding chat UI bundle as Physalia.GH.chat.html…" />
		<ItemGroup>
			<EmbeddedResource Include="$(MSBuildProjectDirectory)\..\Physalia.UI\dist\index.html"
			                  LogicalName="Physalia.GH.chat.html" />
		</ItemGroup>
	</Target>

	<!-- Merge the managed dependency DLLs into the single .gha (ILRepack) so the plugin ships as
	     one self-contained file instead of a .gha + loose DLL folder, and so its copies of
	     JsonSchema.Net / SharpToken / GhJSON are internalized — isolating them from version
	     clashes with other plugins in Grasshopper's shared load context.
	     Every merged dep is pure-managed IL, so the result runs identically on .NET 7 CoreCLR on
	     Windows and Mac; embedding adds no native/RID risk.
	     Host-provided assemblies stay EXTERNAL (never merged): Grasshopper (ExcludeAssets=runtime),
	     System.Drawing.Common (ExcludeAssets=runtime; Rhino supplies it on Mac), and the Rhino SDK
	     references (Private=False). They don't reach the output dir, but the denylist is a
	     belt-and-suspenders guard against a stray transitive copy.
	     Pass -p:RepackGha=false to skip the merge for fast inner-loop builds (loose DLLs remain).
	     The TargetFramework guard keeps this out of the outer multi-targeting dispatch build,
	     same reason as CopyLibraryFiles. -->
	<PropertyGroup>
		<RepackGha Condition="'$(RepackGha)' == ''">true</RepackGha>
	</PropertyGroup>

	<Target Name="RepackGha" AfterTargets="Build"
	        Condition="'$(RepackGha)' == 'true' and '$(TargetFramework)' != ''">
		<ItemGroup>
			<!-- Host- / framework-provided assemblies that must remain external references. -->
			<RepackDenyList Include="System.Drawing.Common" />
			<RepackDenyList Include="RhinoCommon" />
			<RepackDenyList Include="Grasshopper" />
			<RepackDenyList Include="GH_IO" />
			<RepackDenyList Include="Eto" />
			<RepackDenyList Include="Rhino.Runtime.Code" />
			<RepackDenyList Include="RhinoCodePlatform.GH" />
			<RepackDenyList Include="RhinoCodePlatform.GH1" />
			<RepackDenyList Include="Microsoft.Web.WebView2.Core" />
			<!-- The JSON stack ships LOOSE, never merged. JsonSchema.Net (pinned to 7.2.2, what
			     GhJSON.Core was compiled against) only ships a netstandard2.0 lib, whose init-only
			     property call sites into System.Text.Json carry the ns2.0 flavor's modreq identity
			     ([System.Text.Json]IsExternalInit); the net7.0 System.Text.Json we deploy declares
			     those accessors against [System.Private.CoreLib]IsExternalInit. Loose, the runtime
			     binds these fine (identical to the configuration the unit tests run); merged and
			     internalized, ILRepack's typeref rewrite produces signatures that can never match
			     and JsonSchema.Net dies with MissingMethodException (set_ObjectCreator) inside the
			     .gha only. Keep every assembly of the stack in one flavor family and out of the
			     merge. -->
			<RepackDenyList Include="JsonSchema.Net" />
			<RepackDenyList Include="Json.More" />
			<RepackDenyList Include="JsonPointer.Net" />
			<RepackDenyList Include="System.Text.Json" />
			<RepackDenyList Include="System.Text.Encodings.Web" />
			<RepackDenyList Include="System.IO.Pipelines" />
			<RepackDenyList Include="Microsoft.Bcl.AsyncInterfaces" />
		</ItemGroup>
		<ItemGroup>
			<!-- Candidate deps = every DLL in the output dir, minus the denylist. -->
			<RepackInputDll Include="$(TargetDir)*.dll"
			                Exclude="@(RepackDenyList->'$(TargetDir)%(Identity).dll')" />
			<!-- Primary assembly MUST be first: the built .gha leads, deps follow. -->
			<RepackInput Include="$(TargetPath)" />
			<RepackInput Include="@(RepackInputDll)" />
			<!-- Search paths so ILRepack can resolve the external host assemblies referenced by the
			     merged deps (GhJSON.Grasshopper → Grasshopper/RhinoCommon/GH_IO; GhJSON → System.Drawing).
			     Derive them from the directories of the actual resolved compile references so the
			     EXACT versions match — the NuGet Grasshopper (8.24) differs from the installed
			     Rhino's copy (8.28), so pointing at the Rhino System dir would fail version resolution. -->
			<RepackLibPath Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
			<RepackLibPath Include="$(TargetDir)" />
		</ItemGroup>
		<Message Importance="high"
		         Text="Physalia.GH: ILRepack merging [@(RepackInputDll->'%(Filename)', ', ')] into $(TargetFileName)" />
		<ILRepack
			Parallel="true"
			Internalize="true"
			InputAssemblies="@(RepackInput)"
			LibraryPath="@(RepackLibPath)"
			TargetKind="Dll"
			OutputFile="$(TargetPath)" />
		<!-- Remove the now-merged loose DLLs (and their sidecars) from the output dir. -->
		<Delete Files="@(RepackInputDll)" />
		<Delete Files="@(RepackInputDll->'%(RootDir)%(Directory)%(Filename).pdb')" />
		<Delete Files="@(RepackInputDll->'%(RootDir)%(Directory)%(Filename).xml')" />
	</Target>

</Project>