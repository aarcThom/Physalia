<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Physalia.UI — the standalone chat window front-end (Vite + Svelte 5 + Tailwind +
    svelte-ai-elements). It builds to a single self-contained HTML file (dist/index.html)
    that Physalia.GH embeds as a resource; the Eto WebView host
    (Physalia.GH/Panels/ChatWindow.cs) extracts it to a temp file at runtime and loads it.

    This is an MSBuild wrapper around the npm toolchain — it compiles no C#. The built
    artifact (dist/index.html) is GITIGNORED (it is ~3 MB minified and reproducible).
    Physalia.GH takes a build-ordering ProjectReference on this project, so a normal build
    (VS or `dotnet build`) runs Vite here first and Physalia.GH then embeds the fresh
    dist/index.html into its assembly (see Physalia.GH's EmbedChatHtml target). The Vite step
    is incremental (skipped when no UI source changed) and can be disabled with
    -p:BuildUI=false for a Node-free build (the chat window then shows a "UI not found" page).
  -->

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- This project produces no managed output of its own. -->
    <NoWarn>$(NoWarn);NETSDK1086</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- CRITICAL: this project emits no assembly, so Visual Studio's fast up-to-date check
         sees no managed outputs and SKIPS the project build entirely — which means the
         BuildPhysaliaUI target below never runs in VS and Files/UI/chat.html is never
         generated (the chat window then shows "UI not found"). `dotnet build` doesn't gate
         on the fast check, which is why CLI builds work but VS builds silently don't.
         Disabling the fast check forces VS to invoke MSBuild every build; the target's own
         Inputs/Outputs still keep it cheap (npm/Vite are skipped when no UI source changed). -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <!-- On by default: the .NET build runs the Vite build and refreshes Files/UI/chat.html
         (gitignored, so there is no committed fallback). Pass -p:BuildUI=false to skip it
         for a Node-free build. -->
    <BuildUI Condition="'$(BuildUI)' == ''">true</BuildUI>
  </PropertyGroup>

  <!-- Inputs that should trigger a UI rebuild: the source tree plus root-level config files.
       Scoped this way so the incremental check can skip npm when nothing changed AND so the
       glob never walks the huge node_modules / dist folders. -->
  <ItemGroup>
    <PhysaliaUiInput Include="$(MSBuildProjectDirectory)\src\**\*" />
    <PhysaliaUiInput Include="$(MSBuildProjectDirectory)\*.json;$(MSBuildProjectDirectory)\*.ts;$(MSBuildProjectDirectory)\*.js;$(MSBuildProjectDirectory)\*.cjs;$(MSBuildProjectDirectory)\*.mjs;$(MSBuildProjectDirectory)\*.html;$(MSBuildProjectDirectory)\*.css" />
  </ItemGroup>

  <!-- Restore npm packages. Incremental via a stamp file: re-runs whenever package-lock.json
       changes (a plain `!Exists(node_modules)` guard never reinstalls after a dependency bump,
       leaving a stale or broken node_modules that makes `npm run build` fail). Uses `npm ci`
       when a lockfile is present (clean, reproducible install) and falls back to `npm install`
       otherwise. -->
  <Target Name="RestorePhysaliaUI" BeforeTargets="BuildPhysaliaUI" Condition="'$(BuildUI)' == 'true'"
          Inputs="$(MSBuildProjectDirectory)\package-lock.json;$(MSBuildProjectDirectory)\package.json"
          Outputs="$(MSBuildProjectDirectory)\node_modules\.physalia-install-stamp">
    <Message Importance="high" Text="Physalia.UI: restoring npm packages…" />
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="Exists('$(MSBuildProjectDirectory)\package-lock.json')" />
    <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="!Exists('$(MSBuildProjectDirectory)\package-lock.json')" />
    <Touch Files="$(MSBuildProjectDirectory)\node_modules\.physalia-install-stamp" AlwaysCreate="true" />
  </Target>

  <!-- Inputs/Outputs make this incremental: npm runs only when a UI source is newer than the
       generated dist/index.html (so plain C# rebuilds don't pay the Vite cost). The bundle is
       NOT copied anywhere here — Physalia.GH embeds dist/index.html directly as a resource
       (see its EmbedChatHtml target), so the canonical output is dist/index.html. -->
  <Target Name="BuildPhysaliaUI" AfterTargets="Build" Condition="'$(BuildUI)' == 'true'"
          Inputs="@(PhysaliaUiInput)"
          Outputs="$(MSBuildProjectDirectory)\dist\index.html">
    <Message Importance="high" Text="Physalia.UI: building chat window front-end with Vite…" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Message Importance="high" Text="Physalia.UI: dist/index.html refreshed (embedded by Physalia.GH)." />
  </Target>

</Project>
