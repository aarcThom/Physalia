# Physalia — MCP servers
#
# Copy this file to MCP_SERVERS.YAML (same folder) and list the MCP servers you want the model to
# be able to reach. Physalia ships no servers of its own: this file is yours.
#
# The block below is the standard `mcpServers` shape used by Claude Code, Claude Desktop and Cursor,
# so a server configuration copied out of any project's README works here unchanged. The JSON form
# of the same thing is also accepted — if you have an existing claude_desktop_config.json, you can
# paste its whole contents into MCP_SERVERS.YAML as-is.
#
# Having listed a server here, place an "MCP Server" component in a harness and pick the server by
# name. Its tools then appear to the model like any other Physalia tool: wire the component's Tool
# output to the LLM Call, and its Result output through a Feedback into a Feedback Collector and
# back to the Router.
#
# CREDENTIALS. Values may reference an environment variable as ${NAME}, and that is the recommended
# way to supply a token. Nothing in this file is ever written into a .gh file or into a preset —
# which is exactly why server details live here and not on the component. A preset carries only the
# server's NAME, so whoever opens it supplies their own credentials in their own copy of this file.

mcpServers:

  # ---------------------------------------------------------------- local (stdio) servers
  # Launched as a subprocess. `command` is looked up on PATH; on Windows the .cmd shims that npm and
  # uv install are found automatically, so plain `npx` and `uvx` work.

  # filesystem:
  #   command: npx
  #   args: ["-y", "@modelcontextprotocol/server-filesystem", "C:/Users/you/Documents/references"]

  # everything:
  #   # The reference server, useful for checking the connection works at all.
  #   command: npx
  #   args: ["-y", "@modelcontextprotocol/server-everything"]

  # git:
  #   command: uvx
  #   args: ["mcp-server-git", "--repository", "C:/path/to/repo"]

  # ---------------------------------------------------------------- remote (HTTP) servers
  # Reached through the Physalia MCP bridge, which handles Streamable HTTP and the OAuth sign-in.
  # The bridge ships beside the plug-in; if it is missing, remote entries report that and local
  # servers keep working.

  # notion:
  #   url: https://mcp.notion.com/mcp

  # ---------------------------------------------------------------- credentials via the environment
  # github:
  #   command: npx
  #   args: ["-y", "@modelcontextprotocol/server-github"]
  #   env:
  #     GITHUB_PERSONAL_ACCESS_TOKEN: ${GITHUB_TOKEN}

  # ---------------------------------------------------------------- other recognised keys
  #   cwd:  working directory for a local server
  #   env:  environment variables overlaid on the inherited ones
  # Keys meant for other MCP hosts are ignored rather than rejected, so one shared config file can
  # serve several clients.
