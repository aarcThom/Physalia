<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GhJSON.Core" Version="1.1.1" />
    <PackageReference Include="GhJSON.Grasshopper" Version="1.1.1" />
    <!-- Pinned to the exact version GhJSON.Core 1.1.1 was compiled against: JsonSchema.Net 9.x
         changed the JsonSchema.FromText signature, and since NuGet unifies to the highest version,
         a 9.x reference here makes GhJSON's schema loading throw MissingMethodException at runtime
         ("Method not found: Json.Schema.JsonSchema.FromText"). Keep in lockstep with the GhJSON
         packages' own JsonSchema.Net dependency when bumping either. -->
    <PackageReference Include="JsonSchema.Net" Version="7.2.2" />
    <PackageReference Include="SharpToken" Version="2.0.6" />
  </ItemGroup>

</Project>
